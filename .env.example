# Environment Variable Configuration for Model Orchestrator
# Copy this file to .env or set environment variables in your server environment.
# NEVER commit actual API keys or secrets to git repository.

# ==============================================================================
# Model Tier API Credentials (Used by RealModelProvider)
# ==============================================================================
# Tier-specific API Keys (Highest priority override for each tier)
MODEL_1_API_KEY=
MODEL_2_API_KEY=
MODEL_3_API_KEY=

# Provider-Specific API Keys (Fallback if model-specific key is not set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Custom API Base URLs (Optional override for local proxies, Ollama, vLLM)
MODEL_1_API_BASE=
MODEL_2_API_BASE=
MODEL_3_API_BASE=
OPENAI_API_BASE=

# ==============================================================================
# Execution Mode Control
# ==============================================================================
# Set to 'true' to force MockModelProvider for offline development or testing
USE_MOCK_PROVIDER=false

# Environment mode: 'production' (default) or 'test'
ORCHESTRATOR_ENV=production
